# career-ops — Environment Variables
# Copy this file to .env and fill in provider keys if your Pi setup reads them
# from the environment.
#
#   cp .env.example .env

# ── Pi model provider keys (optional) ────────────────────────────────────────
# Pi can use multiple providers. Configure Pi however you prefer; these are
# common environment variable names for API-key based setups.
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_key_here

# ── Other integrations (add your own below) ──────────────────────────────────
